# Только локальная разработка. Публичный запуск заблокирован до OAuth.
GEO_MODE=local
GEO_HOST=127.0.0.1
GEO_PORT=8787
GEO_DATA_DIR=data
BASE_URL=http://127.0.0.1:8787
GEO_OSM_ENABLED=false
GEO_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
# Включать OSM после указания настоящего контакта оператора.
GEO_OSM_USER_AGENT=GeoOSINT/0.1 (operator contact required)
GEO_MAX_CASES=100
GEO_MAX_CANDIDATES=500
GEO_CACHE_BYTES=33554432
GEO_MAX_UPLOAD_BYTES=26214400
GEO_MAX_ARTIFACTS_PER_CASE=10
# OAuth-настройки обязательны только для production; настоящие значения вне Git.
# GEO_OPERATOR_PASSWORD_HASH=<ARGON2ID_HASH>
# GEO_REDIRECT_URIS=["https://EXACT_CLIENT_CALLBACK"]
# GEO_ORIGINS=[]
# GEO_BOUNDARIES_FILE=/data/boundaries.json
